---
import "katex/dist/katex.min.css";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";


type Props = {
title: string;
description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">

<head>

    <Head title={`${title} | ${SITE.TITLE}`} description={description} />
</head>

<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
    <Pagefind />
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>
    <script>
        function renderMathIfAvailable() {
          if (typeof renderMathInElement === "function") {
            renderMathInElement(document.body, {
              delimiters: [
                { left: "$$", right: "$$", display: true },
                { left: "$", right: "$", display: false },
              ],
            });
          }
        }
        document.addEventListener("DOMContentLoaded", renderMathIfAvailable);
        document.addEventListener("astro:after-swap", renderMathIfAvailable);
    </script>
</body>
</html>